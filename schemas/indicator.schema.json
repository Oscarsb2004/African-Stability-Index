{
  "$defs": {
    "ReproClass": {
      "description": "How much of a value was recreated (P5).",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "ReproClass",
      "type": "string"
    }
  },
  "$id": "athena-core/indicator.schema.json",
  "additionalProperties": false,
  "properties": {
    "code": {
      "title": "Code",
      "type": "string"
    },
    "framework": {
      "title": "Framework",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "method": {
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Method",
      "type": "string"
    },
    "repro_class": {
      "$ref": "#/$defs/ReproClass"
    },
    "sources": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "unit": {
      "title": "Unit",
      "type": "string"
    },
    "version": {
      "default": "0.1.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "framework",
    "code",
    "unit",
    "method",
    "sources",
    "repro_class"
  ],
  "title": "Indicator",
  "type": "object"
}
