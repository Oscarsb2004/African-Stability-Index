{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "A locator in a stored document, and the quote that must be found verbatim there.",
      "properties": {
        "document": {
          "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Document",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document",
        "locator",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "$id": "athena-core/grouping.schema.json",
  "additionalProperties": false,
  "properties": {
    "citation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Citation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "disjoint": {
      "title": "Disjoint",
      "type": "boolean"
    },
    "groups": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Groups",
      "type": "object"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "publisher": {
      "title": "Publisher",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "version": {
      "default": "0.1.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "publisher",
    "groups",
    "disjoint"
  ],
  "title": "Grouping",
  "type": "object"
}
