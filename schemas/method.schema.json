{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "A locator in a stored document, and the quote that must be found verbatim there.",
      "properties": {
        "document": {
          "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Document",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document",
        "locator",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "MethodStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "shell": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shell"
        }
      },
      "required": [
        "number",
        "name",
        "action"
      ],
      "title": "MethodStep",
      "type": "object"
    },
    "Origin": {
      "description": "Where a method comes from (P4). Everything an own method produces is labelled derived.",
      "enum": [
        "published",
        "own"
      ],
      "title": "Origin",
      "type": "string"
    },
    "PublishedValue": {
      "additionalProperties": false,
      "description": "A value the publisher releases part-way through the method: a country table, a group list, a count.",
      "properties": {
        "after_step": {
          "title": "After Step",
          "type": "integer"
        },
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "after_step",
        "description",
        "citation"
      ],
      "title": "PublishedValue",
      "type": "object"
    },
    "Reading": {
      "additionalProperties": false,
      "description": "A sentence that can be read more than one way, the reading taken, and why.",
      "properties": {
        "adopted": {
          "title": "Adopted",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "owner_ruled": {
          "default": false,
          "title": "Owner Ruled",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "sentence": {
          "$ref": "#/$defs/Citation"
        },
        "step": {
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "step",
        "sentence",
        "options",
        "adopted",
        "reason"
      ],
      "title": "Reading",
      "type": "object"
    },
    "Rounding": {
      "additionalProperties": false,
      "properties": {
        "decimals": {
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "rule": {
          "$ref": "#/$defs/RoundingRule",
          "default": "half-up"
        },
        "stated_by_publisher": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "decimals"
      ],
      "title": "Rounding",
      "type": "object"
    },
    "RoundingRule": {
      "enum": [
        "half-up",
        "half-even"
      ],
      "title": "RoundingRule",
      "type": "string"
    }
  },
  "$id": "athena-core/method.schema.json",
  "additionalProperties": false,
  "properties": {
    "formula": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Formula"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "published_values": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PublishedValue"
      },
      "title": "Published Values",
      "type": "array"
    },
    "readings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Reading"
      },
      "title": "Readings",
      "type": "array"
    },
    "rounding": {
      "anyOf": [
        {
          "$ref": "#/$defs/Rounding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/MethodStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "subject": {
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Subject",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "version": {
      "default": "0.1.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "subject",
    "origin",
    "steps"
  ],
  "title": "MethodCard",
  "type": "object"
}
